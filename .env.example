POSTGRES_DB=oem_service_unit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oem_service_unit
REDIS_URL=redis://localhost:6379
AI_ENABLED=false
OPENROUTER_API_KEY=
