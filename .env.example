POSTGRES_DB=oem_service_unit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oem_service_unit
REDIS_URL=redis://localhost:6379
AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=3
WORKER_LOG_COMPLETED=false
SIMULATOR_STARTUP_DELAY_MS=4000

JWT_SECRET=change-me-in-production-use-a-random-64-char-string

# Public deployment. Leave mutations off. List every browser origin, one per domain.
PUBLIC_DEMO=true
ALLOW_MUTATIONS=false
ENABLE_QUEUE_ADMIN=false
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Example once both portfolios point at this instance:
# CORS_ORIGINS=https://fleet.domainname.com,https://fleet.domainname2.com
