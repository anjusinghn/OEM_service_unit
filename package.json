{
  "name": "kazindustries",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node ./dev.mjs",
    "dev:chennai": "node ./scripts/chennai.mjs",
    "dev:api": "pnpm --filter @kaz/api dev",
    "dev:turbo": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @kaz/web dev",
    "dev:worker": "pnpm --filter @kaz/worker dev",
    "dev:simulator": "pnpm --filter @kaz/simulator dev",
    "test:ai-live": "RUN_LIVE_AI_TESTS=true pnpm --filter @kaz/api exec vitest run --config vitest.config.ts src/__tests__/ai-live.test.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  }
}
