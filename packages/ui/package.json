{
  "name": "@kaz/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --out-dir dist",
    "dev": "tsup src/index.tsx --format esm --watch --dts --out-dir dist",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13"
  }
}
